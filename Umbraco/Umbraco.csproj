<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="App_Plugins\Astroboard\astroboard\dist\index.html" />
    <Content Include="App_Plugins\Astroboard\astroboard\dist\_astro\Dashboard.IfoPnuIB.css" />
    <Content Include="App_Plugins\Astroboard\astroboard\dist\_astro\index.Bwsrms2G.css" />
    <Content Include="App_Plugins\Astroboard\Lang\en-US.xml" />
    <Content Include="App_Plugins\BlockGridPreviews\navigationgroup.html" />
  </ItemGroup>
  <ItemGroup>
    <None Include="App_Plugins\Astroboard\astroboard\dist\favicon.svg" />
    <None Include="App_Plugins\Astroboard\astroboard\dist\_astro\client.Cc-yzRk5.js" />
    <None Include="App_Plugins\Astroboard\astroboard\dist\_astro\client.Co0vMr8l.js" />
    <None Include="App_Plugins\Astroboard\astroboard\dist\_astro\Dashboard.Cyz0v-4j.js" />
    <None Include="App_Plugins\Astroboard\astroboard\dist\_astro\runtime-dom.esm-bundler.kMU7b04P.js" />
    <None Include="App_Plugins\Astroboard\package.manifest" />
    <None Include="App_Plugins\BlockGridPreviews\package.manifest" />
    <None Include="App_Plugins\Custom\backoffice\js\custom.js" />
    <None Include="App_Plugins\Custom\package.manifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="astroboard" Version="1.1.1" />
    <PackageReference Include="Our.Umbraco.Community.Contentment" Version="4.7.0" />
    <PackageReference Include="Umbraco.Cms" Version="13.6.0-rc" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageReference Include="uSync" Version="13.2.6" />
    <ProjectReference Include="..\PocApp.Application\PocApp.Application.csproj" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

   <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

</Project>
